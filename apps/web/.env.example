# URL base de la API de WordPress headless.
VITE_API_URL=http://localhost:8080/wp-json/up10/v1

# URL pública del sitio, usada en canonical, OG y sitemap.
VITE_SITE_URL=http://localhost:5173

# Usar fixtures locales en lugar de la API real.
# Poner "false" cuando WordPress esté disponible.
VITE_USE_MOCKS=true

# Refrescar datos en el navegador después del prerender (demo).
# En el build final se puede poner "false" para servir el HTML estático.
VITE_LIVE_CONTENT=true
